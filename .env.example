# Neon pooled connection string. Use the hostname containing "-pooler".
DATABASE_URL=postgresql://user:password@example-pooler.us-west-2.aws.neon.tech/pocketcloud?sslmode=require

# Private Vercel Blob store credential for local development.
BLOB_READ_WRITE_TOKEN=replace-with-private-store-token

# At least 32 random characters; hashes prototype browser IDs and fallback IP keys.
ACTOR_HASH_SECRET=replace-with-at-least-32-random-characters

# Clerk customer accounts. These are the names created by the gopocketcloud
# Vercel Marketplace integration. NEXT_PUBLIC values are exposed to the browser;
# the secret key is server-only and must never be committed.
NEXT_PUBLIC_gopocketcloud_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
gopocketcloud_CLERK_SECRET_KEY=sk_test_replace-me
# Standard Clerk names remain supported for local development and other integrations.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# Optional. Operator routes are registered only when this is configured.
OPERATOR_API_KEY=replace-with-a-separate-operator-secret

# Trusted-host credentials used by the worker deployment adapter and operator removal flow.
# These values are never copied into a customer Sandbox.
VERCEL_TOKEN=replace-with-vercel-access-token
VERCEL_PROJECT_NAME=pocketcloud-apps

# Optional Vercel scope identifiers.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional stable worker identity. A random process identity is generated when omitted.
POCKETCLOUD_WORKER_ID=worker-local-1

# At least 32 random characters. Vercel sends it as a Bearer token to scheduled cleanup.
CRON_SECRET=replace-with-a-separate-32-character-cron-secret

# Vercel injects VERCEL_OIDC_TOKEN and VERCEL=1 automatically in hosted Functions.
# Do not create or commit a long-lived OIDC token.

# Optional bounded AI repair through Vercel AI Gateway. Enabling this can spend AI credits.
# Confirm the Gateway credit and auto-top-up policy first. The model must use an openai/* ID.
POCKETCLOUD_AI_REPAIR_ENABLED=0
POCKETCLOUD_AI_REPAIR_MODEL=openai/gpt-5.4-mini

# Pilot safety controls. Concurrency is durably enforced across workers through PostgreSQL claims.
POCKETCLOUD_GLOBAL_CONCURRENCY=3
POCKETCLOUD_RETENTION_SWEEP_INTERVAL_MS=300000

PORT=8787
