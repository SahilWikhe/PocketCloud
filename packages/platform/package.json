{
  "name": "@pocketcloud/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:vercel": "tsx src/database/migrate-vercel.ts",
    "test": "vitest run --fileParallelism=false --hookTimeout=30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pocketcloud/core": "workspace:*",
    "@vercel/blob": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@types/pg": "latest"
  }
}
